{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CONTRIBUTING.md"],
  "permission": {
    "bash": {
      "gh pr merge*": "deny",
      "gh pr review*": "deny",
      "gh pr close*": "deny",
      "git push*--force*": "deny",
      "git push* -f*": "deny",
      "git push* +*": "deny",
      "git push*--delete*": "deny",
      "git push*--mirror*": "deny",
      "git push* main*": "deny",
      "git push*:main*": "deny",
      "git push*refs/heads/main*": "deny",
      "gh api *": "ask"
    }
  }
}
